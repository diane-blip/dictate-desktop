# Copy this file to .env and fill in your key. .env is gitignored — never commit it.

# Groq powers BOTH transcription (Whisper) and the cleanup pass (Llama).
# It's the only key you need. Free at https://console.groq.com.
GROQ_API_KEY=

# Optional. Only needed if you switch a provider to "openai" in config.toml
# (OpenAI can do transcription and/or the cleanup pass instead of Groq).
OPENAI_API_KEY=
