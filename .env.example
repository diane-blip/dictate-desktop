# Copy this file to .env and fill in real keys. .env is gitignored — never commit it.

# Speech-to-text. Only the key for the provider set in config.toml is needed.
GROQ_API_KEY=
OPENAI_API_KEY=

# Cleanup pass (strips ums, applies snippets). Optional — without it the app
# falls back to the raw transcript + local snippet matching.
ANTHROPIC_API_KEY=
